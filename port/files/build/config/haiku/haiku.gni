declare_args() {
  # Prefix for the Haiku cross toolchain's binutils, when building on a
  # non-Haiku host. Empty when building natively on Haiku, where the tools
  # are unprefixed. Only the gcc fallback toolchain uses it: the clang
  # toolchains use Chromium's own clang and lld.
  haiku_toolprefix = ""

  # Root of a Haiku sysroot: the directory holding boot/system/develop.
  # Empty means build natively against the running system.
  haiku_sysroot = ""

  # The directory holding gcc's crtbeginS.o and libgcc for the target
  # (boot/system/develop/tools/lib/gcc/<triple>/<version> in the sysroot).
  # clang's Haiku driver links them, but does not look there by itself in a
  # cross build.
  haiku_gcc_lib_dir = ""
}
