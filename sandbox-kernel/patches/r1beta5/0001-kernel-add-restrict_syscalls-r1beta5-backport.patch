+++ b/headers/os/kernel/OS.h
@@ -423,6 +423,35 @@ extern void			debugger(const char *message);
 */
 extern int			disable_debugger(int state);
 
+/* Syscall restriction */
+
+enum {
+	B_SYSCALL_GROUP_BASIC		= 0x0001,
+		/* memory, the team's own threads, semaphores and areas, signals to
+		   itself, time, and descriptors the team already has */
+	B_SYSCALL_GROUP_FILE_READ	= 0x0002,
+		/* opening, reading and stat()ing by path, read-only */
+	B_SYSCALL_GROUP_FILE_WRITE	= 0x0004,
+		/* creating, writing, renaming and removing by path */
+	B_SYSCALL_GROUP_SOCKET		= 0x0008,
+		/* socket(), bind(), listen(), accept(), connect() */
+	B_SYSCALL_GROUP_PROCESS		= 0x0010,
+		/* fork(), exec(), load_image(), waiting for children */
+	B_SYSCALL_GROUP_PORT		= 0x0020,
+		/* every port syscall, and node and system monitoring */
+	B_SYSCALL_GROUP_AREA_SHARE	= 0x0040,
+		/* cloning and transferring areas */
+	B_SYSCALL_GROUP_DEBUG		= 0x0080,
+		/* debuggers and debugging other threads */
+	B_SYSCALL_GROUP_SYSTEM		= 0x0100,
+		/* everything else, including every syscall added later */
+
+	B_SYSCALL_GROUP_ALL			= 0x01ff
+};
+
+extern status_t		restrict_syscalls(uint32 allowedGroups);
+						/* irreversible; inherited by new teams */
+
 /* TODO: Remove. Temporary debug helper. */
 extern void			debug_printf(const char *format, ...)
 						__attribute__ ((format (__printf__, 1, 2)));
diff --git a/headers/private/kernel/syscall_filter.h b/headers/private/kernel/syscall_filter.h
new file mode 100644
index 00000000..f860d9a5
--- /dev/null
+++ b/headers/private/kernel/syscall_filter.h
@@ -0,0 +1,39 @@
+/*
+ * Copyright 2026, RenkuOS contributors.
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef _KERNEL_SYSCALL_FILTER_H
+#define _KERNEL_SYSCALL_FILTER_H
+
+
+#include <OS.h>
+
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+status_t syscall_filter_init(void);
+
+/*!	Called on every syscall of a thread that has THREAD_FLAGS_SYSCALL_FILTERED
+	set, before the syscall runs. \a args are the syscall's arguments, one
+	64 bit slot each. Returns \c B_OK to let the syscall run, or the error
+	(\c B_NOT_ALLOWED) to return instead.
+*/
+status_t syscall_filter_check(uint32 syscall, const uint64* args);
+
+/*!	Whether the current team may call the generic syscall \a function of
+	\a subsystem, which must be a kernel copy of the name. Generic syscalls
+	are dispatched by name, so syscall_filter_check() cannot tell them apart.
+*/
+bool syscall_filter_allows_generic_syscall(const char* subsystem,
+	uint32 function);
+
+status_t _user_restrict_syscalls(uint32 allowedGroups);
+
+#ifdef __cplusplus
+}
+#endif
+
+
+#endif	/* _KERNEL_SYSCALL_FILTER_H */
