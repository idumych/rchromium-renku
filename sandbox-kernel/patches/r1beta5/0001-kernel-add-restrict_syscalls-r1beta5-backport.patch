diff --git a/src/system/kernel/arch/x86/64/entry_compat.S b/src/system/kernel/arch/x86/64/entry_compat.S
index 855044ae..2eda149b 100644
--- a/src/system/kernel/arch/x86/64/entry_compat.S
+++ b/src/system/kernel/arch/x86/64/entry_compat.S
@@ -259,6 +259,10 @@ FUNCTION(x86_64_sysenter32_entry):
 	movq	$0, THREAD_fault_handler(%r12)
 
 .Lperform_syscall:
+	testl	$THREAD_FLAGS_SYSCALL_FILTERED, THREAD_flags(%r12)
+	jnz		.Lsyscall_filter
+
+.Lsyscall_filter_done:
 	testl	$THREAD_FLAGS_DEBUGGER_INSTALLED, THREAD_flags(%r12)
 	jnz		.Lpre_syscall_debug
 
@@ -318,6 +322,26 @@ FUNCTION(x86_64_sysenter32_entry):
 	sysexit
 
 
+.Lsyscall_filter:
+	// The team has restricted its syscalls (restrict_syscalls()). A 64 bit
+	// team can reach this entry by switching to the 32 bit code segment, so
+	// it is checked here as in the native entry. The arguments are on the
+	// stack, one 64 bit slot each.
+	movq	%r14, %rdi				// syscall number
+	movq	%rsp, %rsi
+	push	%rax					// syscall table entry
+	subq	$8, %rsp
+	call	syscall_filter_check
+	addq	$8, %rsp
+	movslq	%eax, %rdx
+	pop		%rax
+	testq	%rdx, %rdx
+	jz		.Lsyscall_filter_done
+	movq	%rdx, IFRAME_ax(%rbp)
+	shrq	$32, %rdx
+	movq	%rdx, IFRAME_dx(%rbp)
+	jmp		.Lsyscall_return
+
 .Lpre_syscall_debug:
 	// preserve registers
 	push	%rdi
diff --git a/src/system/kernel/arch/x86/64/interrupts.S b/src/system/kernel/arch/x86/64/interrupts.S
index 1821f2a2..0349b193 100644
--- a/src/system/kernel/arch/x86/64/interrupts.S
+++ b/src/system/kernel/arch/x86/64/interrupts.S
@@ -429,6 +429,10 @@ FUNCTION(x86_64_syscall_entry):
 	ja		.Lsyscall_stack_args
 
 .Lperform_syscall:
+	testl	$THREAD_FLAGS_SYSCALL_FILTERED, THREAD_flags(%r12)
+	jnz		.Lsyscall_filter
+
+.Lsyscall_filter_done:
 	testl	$THREAD_FLAGS_DEBUGGER_INSTALLED, THREAD_flags(%r12)
 	jnz		.Lpre_syscall_debug
 
@@ -494,6 +498,31 @@ FUNCTION(x86_64_syscall_entry):
 	swapgs
 	sysretq
 
+.Lsyscall_filter:
+	// The team has restricted its syscalls (restrict_syscalls()).
+	// syscall_filter_check() takes a block of arguments, like
+	// user_debug_pre_syscall below, and returns B_OK or the error to return
+	// instead of making the call.
+	push	IFRAME_r9(%rbp)
+	push	IFRAME_r8(%rbp)
+	push	IFRAME_r10(%rbp)
+	push	IFRAME_dx(%rbp)
+	push	IFRAME_si(%rbp)
+	push	IFRAME_di(%rbp)
+	movq	%r14, %rdi				// syscall number
+	movq	%rsp, %rsi
+	push	%rax					// syscall table entry
+	subq	$8, %rsp
+	call	syscall_filter_check
+	addq	$8, %rsp
+	movslq	%eax, %rdx
+	pop		%rax
+	addq	$48, %rsp
+	testq	%rdx, %rdx
+	jz		.Lsyscall_filter_done
+	movq	%rdx, IFRAME_ax(%rbp)
+	jmp		.Lsyscall_return
+
 .Lpre_syscall_debug:
 	// user_debug_pre_syscall expects a pointer to a block of arguments, need
 	// to push the register arguments onto the stack.
